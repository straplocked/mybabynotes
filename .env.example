# Copy to .env for local dev (git-ignored). Generate values:
#   APP_KEY:            echo "base64:$(openssl rand -base64 32)"
#   REVERB_APP_SECRET:  openssl rand -hex 24
APP_KEY=
REVERB_APP_SECRET=

# Email (optional). Left unset, the app degrades gracefully: invites show a
# shareable code and "Forgot password?" explains mail isn't set up. Real SMTP
# credentials go in .env only — never commit them.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=you@example.com
# MAIL_PASSWORD=app-password
# MAIL_FROM_ADDRESS=you@example.com
# MAIL_SCHEME=smtps   # only for implicit-TLS servers (usually port 465)

# Database (optional). Unset, the app uses SQLite in the babylog-db volume —
# one file, nothing else to run. Point it at a Postgres you already have by
# uncommenting these (the image ships pdo_pgsql). There's no migration between
# drivers: switching starts from an empty database. See docs/operations.md.
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=babylog
# DB_USERNAME=babylog
# DB_PASSWORD=

# Reverse proxy (optional). IPs/CIDRs allowed to speak for clients via
# X-Forwarded-For, so rate limits key on real client addresses instead of
# the proxy's. Leave unset when not behind a proxy.
# TRUSTED_PROXIES=192.168.1.10
